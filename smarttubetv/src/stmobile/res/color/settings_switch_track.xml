<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track color: translucent red track when ON, subtle dark track when OFF -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#1A8E8E93" />
    <item android:state_checked="true" android:color="#80FF0033" />
    <item android:state_checked="false" android:color="#338E8E93" />
    <item android:color="#338E8E93" />
</selector>
