<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb color: vibrant red when ON, subtle muted gray when OFF -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#4D8E8E93" />
    <item android:state_checked="true" android:color="#FF0033" />
    <item android:state_checked="false" android:color="#8E8E93" />
    <item android:color="#8E8E93" />
</selector>
