<?xml version="1.0" encoding="utf-8"?>
<!--
     Bottom-nav icon/label tint: vibrant red #FF0033 when active/filled,
     muted secondary when unselected.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="#FF0033" />
    <item android:state_selected="true" android:color="#FF0033" />
    <item android:color="@color/mobile_color_on_surface_secondary" />
</selector>
