<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass Pill Field for "Add a comment..." / "Add a reply..." input rows.
  - Ambient depth base: soft translucent shadow
  - Translucent glass body with subtle outline
  - Specular reflection sheen along top curve
  - Rounded 19dp mask preventing ripple spill
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <!-- Ambient depth base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <solid android:color="@color/mobile_glass_shadow" />
                </shape>
            </item>

            <!-- Translucent glass field body with subtle outline -->
            <item
                android:bottom="1dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <solid android:color="@color/mobile_glass_surface_control" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/mobile_glass_outline_subtle" />
                </shape>
            </item>

        </layer-list>
    </item>
</ripple>
