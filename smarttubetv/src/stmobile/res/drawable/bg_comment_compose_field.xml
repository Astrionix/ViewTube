<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass pill field for "Add a comment..." in comments and replies. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface_control" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/mobile_glass_outline_subtle" />
        </shape>
    </item>
</ripple>
