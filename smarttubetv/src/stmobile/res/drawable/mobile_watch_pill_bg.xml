<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Obsidian Black Capsule for Watch Page Action Pills.
  - Ambient soft shadow
  - Solid obsidian body with crisp outline
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient depth base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/mobile_glass_shadow" />
        </shape>
    </item>

    <!-- Solid obsidian body with thin outline -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/mobile_glass_surface" />
            <stroke
                android:width="@dimen/mobile_glass_border_width"
                android:color="@color/mobile_glass_outline" />
        </shape>
    </item>
</layer-list>
