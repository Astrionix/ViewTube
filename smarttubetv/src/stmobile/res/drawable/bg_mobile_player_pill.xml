<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Obsidian Black HUD Capsule for Player Overlays:
  - Scrubbing time & chapter indicator
  - Hold-to-speed ("2x") and "Release to cancel" top pill
  - Gesture swipe levels (volume / brightness HUD)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient depth base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>

    <!-- Solid obsidian HUD body with subtle outline -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#141419" />
            <stroke
                android:width="1dp"
                android:color="#2E2E3E" />
        </shape>
    </item>
</layer-list>
