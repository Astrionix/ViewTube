<?xml version="1.0" encoding="utf-8"?>
<!--
    Apple Obsidian Black Floating Navigation Dock:
    - Ambient restrained base shadow
    - Solid Obsidian body with fine Apple-grade edge
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient dark base shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mobile_glass_corner_radius_capsule" />
            <solid android:color="@color/mobile_glass_shadow" />
        </shape>
    </item>

    <!-- Solid Apple Obsidian body with fine outline -->
    <item
        android:bottom="1dp"
        android:left="0.5dp"
        android:right="0.5dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface" />
            <stroke
                android:width="@dimen/mobile_glass_border_width"
                android:color="@color/mobile_glass_outline" />
            <corners android:radius="@dimen/mobile_glass_corner_radius_capsule" />
        </shape>
    </item>
</layer-list>
