<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple Obsidian Black Capsule for In-Player Action Pills.
  - Ambient soft shadow
  - Solid obsidian body with crisp 1dp outline
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient depth base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Solid obsidian pill body with subtle outline -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1B1B22" />
            <stroke
                android:width="1dp"
                android:color="#2E2E3E" />
        </shape>
    </item>
</layer-list>
