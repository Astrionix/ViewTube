<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass docked composer surface above keyboard. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outline border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_outline" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
    <!-- Glass surface -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface_card" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
    <!-- Top specular highlight sheen -->
    <item
        android:height="1dp"
        android:top="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_highlight" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
