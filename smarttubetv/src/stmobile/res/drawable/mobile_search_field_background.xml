<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass rounded capsule for the Search toolbar input field. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface_control" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/mobile_glass_outline_subtle" />
        </shape>
    </item>
</layer-list>
