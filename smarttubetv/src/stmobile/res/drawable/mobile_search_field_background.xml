<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass rounded capsule for the Search toolbar input field. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient depth base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/mobile_glass_shadow" />
        </shape>
    </item>

    <!-- Translucent glass field body with subtle outline -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/mobile_glass_surface_control" />
            <stroke
                android:width="1dp"
                android:color="@color/mobile_glass_outline_subtle" />
        </shape>
    </item>

</layer-list>
