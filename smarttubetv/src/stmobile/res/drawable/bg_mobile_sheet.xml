<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern Bottom Sheet Surface (Single Container, 24dp Top Radius)
  Clean, minimal, production-ready surface using the theme surface color.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="@dimen/mobile_sheet_corner_radius"
        android:topRightRadius="@dimen/mobile_sheet_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <solid android:color="@color/mobile_color_surface" />
</shape>
