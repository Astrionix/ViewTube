<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass popup menu surface for comments sort and item actions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface_card" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/mobile_glass_outline" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_highlight" />
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp" />
        </shape>
    </item>
</layer-list>
