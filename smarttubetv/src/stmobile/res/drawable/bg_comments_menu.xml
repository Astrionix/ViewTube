<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass popup menu surface for comments sort and item actions. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_glass_surface_card" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/mobile_glass_outline" />
        </shape>
    </item>
</layer-list>
