<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass Capsule Background (ViewTube Design System)
  - Ambient depth base: subtle soft shadow
  - Translucent glass body: theme-aware fill with crisp, thin reflective border
  - Specular top rim reflection: linear gradient highlight simulating refracted light
  - Smooth rounded capsule silhouette with zero rectangular artifacts
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient depth base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mobile_glass_corner_radius_capsule" />
            <solid android:color="@color/mobile_glass_shadow" />
        </shape>
    </item>

    <!-- Translucent glass body with thin reflective outline -->
    <item
        android:bottom="1dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mobile_glass_corner_radius_capsule" />
            <solid android:color="@color/mobile_glass_surface" />
            <stroke
                android:width="@dimen/mobile_glass_border_width"
                android:color="@color/mobile_glass_outline" />
        </shape>
    </item>

    <!-- Specular light sheen on top glass rim -->
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mobile_glass_corner_radius_capsule" />
            <gradient
                android:angle="270"
                android:startColor="@color/mobile_glass_highlight"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
