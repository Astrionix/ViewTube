<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass Mini-Player Metadata Scrim (ViewTube Design System)
  Subtle gradient vignette preserving readable title and secondary metadata over bright video.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="@dimen/mobile_glass_corner_radius_card"
        android:bottomRightRadius="@dimen/mobile_glass_corner_radius_card" />
    <gradient
        android:angle="270"
        android:startColor="@android:color/transparent"
        android:centerColor="#73000000"
        android:endColor="#CC000000"
        android:type="linear" />
</shape>
