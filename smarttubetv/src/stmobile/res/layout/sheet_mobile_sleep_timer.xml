<?xml version="1.0" encoding="utf-8"?>
<!--
  Sleep timer bottom sheet, modeled on YouTube's mobile interface with Liquid Glass styling.
  Displays active timer status (if running), quick "+15 min" extension, and preset options
  (Off, 10m, 15m, 20m, 30m, 45m, 60m, End of video).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mobile_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle" />

        <TextView
            android:id="@+id/sleep_timer_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="@string/mobile_player_sleep_timer"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/mobile_color_divider" />

        <!-- Status card when a timer is currently active -->
        <LinearLayout
            android:id="@+id/sleep_timer_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_player_sleep_timer"
                android:tint="@color/mobile_color_on_surface" />

            <TextView
                android:id="@+id/sleep_timer_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="14sp"
                tools:text="Playback will stop in 24 minutes" />

        </LinearLayout>

        <!-- Quick +15m action when active -->
        <LinearLayout
            android:id="@+id/sleep_timer_add_15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mobile_add"
                android:tint="@color/mobile_color_on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mobile_sleep_timer_add_15"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="15sp" />

        </LinearLayout>

        <View
            android:id="@+id/sleep_timer_actions_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="@color/mobile_color_divider"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Flat choice list (item_mobile_quality_row) -->
        <LinearLayout
            android:id="@+id/sleep_timer_sheet_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
