<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch AppDialog renderer - Wave 3 + polish.

  The single Material renderer of AppDialogPresenter's List<OptionCategory>, used for every
  long-press context menu / player option picker (ARCHITECTURE.md section 4). The activity
  theme is now translucent (Theme.NewTube.Dialog), so this root FrameLayout starts transparent -
  the caller (Home / the landscape player) stays visible behind it, which (a) removes the ~1-2s
  black flash before content renders and (b) lets the system keep the caller's orientation
  instead of force-rotating to portrait.

  MobileAppDialogActivity presents every dialog as a BOTTOM SHEET (context menus, the player
  pickers, overlay dialogs): the scrim is shown, the content is anchored to the bottom with a
  rounded top + drag handle and sizes to its content (capped by MaxHeightRecyclerView). The
  phone Settings have their own screen (com.newtube.mobile.ui.settings) since 1.15.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dim scrim behind the sheet (sheet mode only); tap to dismiss. -->
    <View
        android:id="@+id/mobile_dialog_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mobile_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mobile_sheet"
        android:orientation="vertical">

        <View
            android:id="@+id/mobile_dialog_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mobile_sheet_handle"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mobile_dialog_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/mobile_dialog_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_dialog_back"
                android:padding="8dp"
                android:src="@drawable/ic_mobile_back_arrow"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/mobile_dialog_logo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_viewtube_logo"
                android:scaleType="fitCenter"
                android:contentDescription="ViewTube" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/mobile_dialog_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Video Title" />

                <TextView
                    android:id="@+id/mobile_dialog_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Everything you need in one place"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/mobile_dialog_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_sheet_close_button"
                android:contentDescription="@string/mobile_dialog_back"
                android:padding="9dp"
                android:src="@drawable/ic_sheet_close" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            android:background="@color/mobile_color_divider" />

        <com.newtube.mobile.ui.dialog.MaxHeightRecyclerView
            android:id="@+id/mobile_dialog_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_mobile_dialog_row" />

    </LinearLayout>

</FrameLayout>
