<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass Mini-Player Overlay (ViewTube Design System)
  Floating live-video card used when an in-app player is minimized over Search, Channel, or Detail screens.
  Refined with subtle translucent glass tint, 16dp rounded curvature, fine edge reflection, and metadata overlay.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_mini_player"
    android:contentDescription="@string/mobile_mini_expand"
    android:layout_width="180dp"
    android:layout_height="102dp"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="@color/mobile_glass_surface_card"
    app:cardCornerRadius="@dimen/mobile_glass_corner_radius_card"
    app:cardElevation="8dp"
    app:strokeColor="@color/mobile_glass_outline"
    app:strokeWidth="@dimen/mobile_glass_border_width"
    tools:visibility="visible">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- NEWTUBE(issue #9): an AspectRatioFrameLayout (FIT), given the video's shape by
             MiniPlayerBridge.fitToVideo: other shapes are letterboxed, not stretched. -->
        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/mobile_mini_player_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/mobile_mini_freeze"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />

        </androidx.media3.ui.AspectRatioFrameLayout>

        <!-- Top specular reflection sheen on glass rim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_glass_card_highlight"
            android:importantForAccessibility="no" />

        <!-- Metadata overlay vignette with readable title and channel info -->
        <LinearLayout
            android:id="@+id/mobile_mini_meta_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_mini_meta_scrim"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mobile_mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/mobile_player_on_video"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Video Title" />

            <TextView
                android:id="@+id/mobile_mini_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                tools:text="Channel Name" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/mobile_mini_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mini_scrim_circle"
            android:contentDescription="@string/mobile_mini_play_pause"
            android:padding="9dp"
            android:src="@drawable/ic_player_pause" />

        <!-- 48dp touch target, wholly inside the card -->
        <ImageButton
            android:id="@+id/mobile_mini_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="0dp"
            android:background="@drawable/bg_mini_scrim_circle_touch"
            android:contentDescription="@string/mobile_mini_close"
            android:padding="15dp"
            android:src="@drawable/ic_sheet_close"
            android:tint="@color/mobile_player_on_video" />

        <ProgressBar
            android:id="@+id/mobile_mini_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressBackgroundTint="@color/mobile_color_progress_track"
            android:progressTint="@color/mobile_color_progress"
            tools:progress="400" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
